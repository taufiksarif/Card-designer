{
  "name": "card-studio",
  "productName": "Card Studio",
  "version": "1.0.0",
  "private": true,
  "description": "Design ID cards and print them one at a time or as a numbered run.",
  "author": "Card Studio",
  "main": "electron/main.js",
  "scripts": {
    "build:helper": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe -nologo -target:winexe -optimize+ -out:electron\\bin\\CardPrint.exe -r:System.Drawing.dll -r:System.Windows.Forms.dll electron\\CardPrint.cs",
    "start": "npm run build:helper && electron .",
    "dist": "npm run build:helper && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.cardstudio.desktop",
    "productName": "Card Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "!electron/bin/**",
      "!electron/*.cs",
      "index.html",
      "app.js",
      "qrcode.js",
      "templates.js",
      "*.css",
      "fonts/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/bin/CardPrint.exe",
        "to": "CardPrint.exe"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "CardStudio-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "CardStudio-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
